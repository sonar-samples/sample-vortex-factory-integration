# Sourced by the factory scripts. Gradle example values; see the swap points in README.
TEST_CMD='./gradlew check'
AGENT_BUILD_TOOLS='Bash(./gradlew check*) Bash(./gradlew test*) Bash(./gradlew compileJava*) Bash(./gradlew checkstyleMain*)'
# Changed files matching this regex must appear in the Vortex result, or the check fails.
SOURCE_REGEX='\.(java|kt)$'
# Used by setup-vortex to index the workspace before the agent starts. Empty skips it.
VORTEX_WARMUP_ECOSYSTEM=java
MAX_REPAIR=${MAX_REPAIR:-2}
MAX_TURNS=${MAX_TURNS:-80}
MAX_BUDGET_USD=${MAX_BUDGET_USD:-8}
MAX_PATCH_FILES=${MAX_PATCH_FILES:-40}
MAX_PATCH_LINES=${MAX_PATCH_LINES:-3000}
